.game-hud {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
}

/* 상단 바 */
.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 20px;
    height: 120px;
}

/* 플레이어 점수 컨테이너 */
.player-score-container {
    width: 200px;
    padding: 15px 20px;
    background-color: rgba(0, 0, 0, 0.7);
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    justify-content: center;
    align-items: center;
}

.left-player {
    border-left-width: 4px;
    border-left-color: rgb(80, 140, 200);
}

.right-player {
    border-left-width: 4px;
    border-left-color: rgb(200, 80, 80);
}

.player-name {
    font-size: 14px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
    margin-bottom: 5px;
}

.score-value {
    font-size: 36px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* 타이머 컨테이너 */
.timer-container {
    width: 150px;
    height: 80px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.85);
    border-width: 3px;
    border-color: rgb(100, 100, 100);
    border-radius: 0;
    justify-content: center;
    align-items: center;
}

.timer-value {
    font-size: 42px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* 타이머 색상 변화 (시간에 따라 C#에서 클래스 추가) */
.timer-container.warning {
    border-color: rgb(200, 150, 50);
}

.timer-container.danger {
    border-color: rgb(200, 80, 80);
}

.timer-container.warning .timer-value {
    color: rgb(255, 200, 100);
}

.timer-container.danger .timer-value {
    color: rgb(255, 100, 100);
}

/* 카운트다운 오버레이 */
.countdown-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
    pointer-events: none;
}

.countdown-value {
    font-size: 120px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}